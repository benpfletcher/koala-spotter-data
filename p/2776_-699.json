Key":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"bce94afb-d7cd-4ee1-acf3-469babae5fe0","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88866","uri":"https://www.gbif.org/occurrence/1655966509","behavior":"Climbing","notes":"This female and joey have visited once before. They were with a male koala who was in an adjacent tree. The joey was very active, leaving mum then coming back. nearly fell from a branch."}],["1655966521",138.8388,-34.92619,15689,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-15",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"b950ceaf-8e38-4008-a4c9-e393856f4d86","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88865","uri":"https://www.gbif.org/occurrence/1655966521","behavior":"Climbing","notes":"This female and joey have visited once before. They were with a male koala who was in an adjacent tree. The joey was very active, leaving mum then coming back. nearly fell from a branch."}],["1655966531",138.83888,-34.92616,15689,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-15",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"7632de21-ff59-4cbd-8c77-bb37ec544e17","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88864","uri":"https://www.gbif.org/occurrence/1655966531","behavior":"Sitting","notes":"We found three koalas within a few metres. This large male was in a tree by himself. A female and joey were in an adjacent tree. Just on dusk. Photo not good"}],["1655966532",138.82738,-34.93953,15691,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-17",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"788ccdc8-9472-408c-b679-8c3694b2e161","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88875","uri":"https://www.gbif.org/occurrence/1655966532","behavior":"Walking"}],["1655966536",138.83794,-34.92525,15683,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-09",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"2a25f837-f503-4775-a49f-a07f3708ef4a","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88701","uri":"https://www.gbif.org/occurrence/1655966536","behavior":"Eating,Sitting,Sleeping","notes":"heard him this morning. has been in the same spot all day. Getting active around 6pm. Assumed it was the one we usually see, but this fellow is different. Has very little white on him. Our usual fellow Kenneth has quite a lot of white."}],["1655966547",138.83875,-34.92627,15704,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-30",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"3f97cca6-61d6-43c8-9080-44750133c7ed","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88946","uri":"https://www.gbif.org/occurrence/1655966547","behavior":"Sitting","notes":"This fellow is 'Kenneth' , the big koala who has been in this tree for over a week now. We saw him over Christmas but did not have time to record sighting. We now know that we have two koalas here regularly. This large one and a smaller one."}],["1655966553",138.83865,-34.92574,15702,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-28",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"f9ffddd4-7c4d-483d-842d-b8ad892bdbe1","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88936","uri":"https://www.gbif.org/occurrence/1655966553","behavior":"Sleeping","notes":"Not sure which koala this is - too high up and difficult to identify."}],["1655966566",138.84403,-34.91029,15692,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-18",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"fa4cd043-994f-4080-8d4d-166fafcd8f89","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88876","uri":"https://www.gbif.org/occurrence/1655966566","behavior":"Walking","notes":"Crossing the road. Cars stopped. Have seen one here once before crossing the road."}],["1655966570",138.83877,-34.92625,15697,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-23",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"61194d2c-c5c9-4443-b0e0-5f83114591a0","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88926","uri":"https://www.gbif.org/occurrence/1655966570","behavior":"Sitting","notes":"Has been around 3 days. Unafraid of people or dogs"}],["1655966572",138.8379,-34.92534,15687,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-13",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"cc79d6c9-c4f7-47e8-9a2d-39c4530c2071","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88807","uri":"https://www.gbif.org/occurrence/1655966572","behavior":"Sitting","notes":"This is a young koala that has been around for a few weeks. The older koala called 'Kenneth' has not appeared for a while."}],["1655966587",138.83846,-34.92583,15704,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-30",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"8ccc1182-48ee-4ce5-9bac-95b01a74affa","catalogNumber":"urn:lsid:bdrs.ala.org.au:Record:88945","uri":"https://www.gbif.org/occurrence/1655966587","behavior":"Sleeping","notes":"This is the small koala, normally seen near the dam. He has moved from the pin oak yesterday and is now in the E cinerea. He/she may be the female with joey we saw in this tree about 6 weeks ago. If so there is no joey now. Have not seen the joey since the original sighting, but have seen this small koala."}],["1655966590",138.83874,-34.92624,15694,20,145,null,null,"",null,null,null,null,null,null,null,null,null,null,"2012-12-20",{"version":1,"datasetKey":"dad84e72-95f7-4709-b564-72a4429942b1","occurrenceId":"6c119521-6e36-470b-a1ff-d70c12712f7e","catalogNumber":"urn:lsid:bdrs.ala.org.au:Recor